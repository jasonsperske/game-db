---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameTable from '../../components/GameTable.astro';
import { site, url } from '../../lib/site';

export const getStaticPaths = () =>
  site().developers.map((entry) => ({ params: { developer: entry.guid }, props: { entry } }));

const { entry } = Astro.props;
const games = site().lookup(entry.games);
---
<Base title={entry.name}>
  <Breadcrumbs items={[{ label: 'Developers', href: url('developer/') }, { label: entry.name }]} />
  <h1>{entry.name}</h1>
  <p class="muted">Developer id <code>{entry.guid}</code></p>
  <GameTable games={games} columns={['platform', 'publisher']} caption={`Games by ${entry.name}`} />
</Base>
