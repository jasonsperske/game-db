---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompanyTable from '../../components/CompanyTable.astro';
import { dataUrl, site } from '../../lib/site';

const items = site().developers;
---
<Base title="Developers">
  <Breadcrumbs items={[{ label: 'Developers' }]} />
  <h1>Developers</h1>
  <p class="downloads"><span class="muted">{items.length} developers ·</span> <a class="chip" href={dataUrl('developers.json')}>JSON</a></p>
  <CompanyTable companies={items} kind="developer" label="Developer" />
</Base>
