---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { dataUrl, site, url } from '../../lib/site';

const items = [...site().developers].sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Developers">
  <Breadcrumbs items={[{ label: 'Developers' }]} />
  <h1>Developers</h1>
  <p class="downloads"><span class="muted">{items.length} developers ·</span> <a class="chip" href={dataUrl('developers.json')}>JSON</a></p>
  <ul class="cards">
    {items.map((p) => (
      <li>
        <a class="card" href={url(`developer/${p.guid}/`)}>
          <div class="title">{p.name}</div>
          <div class="meta">{p.games.length} {p.games.length === 1 ? 'game' : 'games'}</div>
        </a>
      </li>
    ))}
  </ul>
</Base>
