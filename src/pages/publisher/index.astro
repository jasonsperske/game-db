---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompanyTable from '../../components/CompanyTable.astro';
import { dataUrl, site } from '../../lib/site';

const items = site().publishers;
---
<Base title="Publishers">
  <Breadcrumbs items={[{ label: 'Publishers' }]} />
  <h1>Publishers</h1>
  <p class="downloads"><span class="muted">{items.length} publishers ·</span> <a class="chip" href={dataUrl('publishers.json')}>JSON</a></p>
  <CompanyTable companies={items} kind="publisher" label="Publisher" />
</Base>
